# Credentials and local Google Chat bridge state
client_secret*.json
meteoplaneradar-chat*.json
.chat-bridge/
__pycache__/
*.pyc

# Native macOS Chat bridge build output
tools/google-chat-macos/.build/
tools/google-chat-macos/.swiftpm/
tools/google-chat-macos/dist/

# Author Google OAuth registration, embedded only by the Mac packaging script
tools/google-chat-macos/config/google-oauth.json

# Local author-provided Google registrations
google-api/

# Windows Google Chat bridge: build products and private author registration
tools/google-chat-windows/**/bin/
tools/google-chat-windows/**/obj/
tools/google-chat-windows/dist/
tools/google-chat-windows/config/google-oauth.json
