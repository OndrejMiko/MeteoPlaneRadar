<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MeteoChat</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ChatCore/ChatCore.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(OAuthConfig)' != ''">
    <EmbeddedResource Include="$(OAuthConfig)" LogicalName="MeteoChat.GoogleOAuth.json" />
  </ItemGroup>
</Project>
