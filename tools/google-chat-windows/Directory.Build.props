<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <MeteoVersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../MeteoPlaneRadar/Version.h'))</MeteoVersionFile>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MeteoVersionFile)')), 'FW_VERSION &quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Authors>MeteoPlaneRadar contributors</Authors>
    <RepositoryUrl>https://github.com/OndrejMiko/MeteoPlaneRadar</RepositoryUrl>
  </PropertyGroup>
</Project>
